# Salin berkas ini jadi .env.local lalu isi nilainya.

# APP_URL: alamat tempat aplikasi ini dijalankan.
# Dipakai untuk tautan mandiri, callback OAuth, dan endpoint API, termasuk
# tautan verifikasi yang tercetak di sertifikat. Ganti dengan alamat publik
# begitu aplikasi online. Kalau dikosongkan, dipakai alamat yang sedang dibuka.
APP_URL="http://localhost:3000"

# Supabase — ambil dari Dashboard > Project Settings > API.
# anon key memang dirancang untuk dipakai di browser dan aman berada di bundle;
# seluruh kewenangannya dibatasi Row Level Security. JANGAN memasukkan
# service_role key ke sini — kunci itu menembus semua aturan keamanan.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Google Gemini, untuk fitur bantuan penulisan deskripsi event (opsional).
GEMINI_API_KEY=""

# Midtrans, untuk event berbayar. Client key memang dipakai di browser.
# Server key JANGAN ditaruh di sini: simpan di Supabase > Edge Functions >
# Secrets dengan nama MIDTRANS_SERVER_KEY.
VITE_MIDTRANS_CLIENT_KEY=""
# Isi "true" hanya untuk transaksi sungguhan. Kosong berarti mode sandbox.
VITE_MIDTRANS_PRODUCTION=""
