// Konfigurasi hosting di Cloudflare Workers (static assets).
// Cloudflare menjalankan `npm run build`, lalu `npx wrangler deploy` mengunggah folder dist.
// Variabel VITE_* dan APP_URL diisi di dasbor: Worker kampushub > Settings > Build > Variables,
// karena Vite menanamkannya saat build.
{
  "name": "kampushub",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Rute seperti /my-rsvps tidak punya berkas sendiri; semuanya dilayani index.html
    // supaya React Router yang menanganinya. Pengganti public/_redirects, yang ditolak Workers.
    "not_found_handling": "single-page-application"
  }
}
