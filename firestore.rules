rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPanitia() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'panitia' || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Collection Group Queries and Top-Level RSVPs
    match /{path=**}/rsvps/{rsvpId} {
      allow read: if isSignedIn();
    }
    
    /**
     * Counter RSVP (attendeeCount / waitlistCount) diperbarui oleh peserta lewat
     * transaksi RSVP, jadi harus diizinkan — tapi dibatasi: hanya dua field itu,
     * tidak boleh negatif, dan hanya boleh berubah satu langkah per transaksi.
     */
    function isRsvpCounterUpdate() {
      return isSignedIn() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['attendeeCount', 'waitlistCount']) &&
             incoming().get('attendeeCount', 0) >= 0 &&
             incoming().get('waitlistCount', 0) >= 0 &&
             math.abs(incoming().get('attendeeCount', 0) - existing().get('attendeeCount', 0)) <= 1 &&
             math.abs(incoming().get('waitlistCount', 0) - existing().get('waitlistCount', 0)) <= 1;
    }

    /**
     * Agregat rating ikut diperbarui peserta saat mengirim ulasan, jadi
     * dibatasi: hanya dua field itu, jumlah ulasan naik paling banyak satu,
     * dan total nilai bergeser paling banyak lima poin (rentang 1-5 bintang).
     */
    function isRatingAggregateUpdate() {
      return isSignedIn() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['ratingSum', 'ratingCount']) &&
             incoming().get('ratingSum', 0) >= 0 &&
             incoming().get('ratingCount', 0) >= 0 &&
             (incoming().get('ratingCount', 0) - existing().get('ratingCount', 0)) >= 0 &&
             (incoming().get('ratingCount', 0) - existing().get('ratingCount', 0)) <= 1 &&
             math.abs(incoming().get('ratingSum', 0) - existing().get('ratingSum', 0)) <= 5;
    }

    /** Peserta waitlist naik jadi terdaftar saat ada yang membatalkan RSVP. */
    function isWaitlistPromotion() {
      return isSignedIn() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
             existing().status == 'waitlist' &&
             incoming().status == 'registered';
    }

    /** Check-in hanya mengubah status dan waktu check-in. */
    function isCheckInUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkedInAt']) &&
             incoming().status == 'checked-in';
    }

    // Penyelenggara event boleh ikut membersihkan RSVP saat event dihapus.
    function isOrganizerOf(eventId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/events/$(eventId)) &&
             get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    match /rsvps/{rsvpId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if ((isAdmin() || isPanitia()) && isCheckInUpdate()) || isWaitlistPromotion();
      allow delete: if isOwner(existing().userId) || isAdmin() || isOrganizerOf(existing().eventId);
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && 
                      (incoming().role == 'mahasiswa' || incoming().role == 'panitia' || incoming().role == 'admin') &&
                      incoming().keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
                      incoming().uid == userId;
      allow update: if (isOwner(userId) && incoming().role != 'admin') || isAdmin();
    }

    // Event Rules
    match /events/{eventId} {
      allow read: if true; // Public can see approved events, but we should refine this
      allow list: if statusFilter() == 'approved' || isPanitia();
      
      function statusFilter() {
        return request.query.limit <= 100 && resource.data.status;
      }

      function isValidEvent(data) {
        return data.title is string && data.title.size() <= 100 &&
               data.description is string && data.description.size() <= 2000 &&
               data.category is string &&
               data.organizerId == request.auth.uid &&
               data.status in ['pending', 'approved', 'rejected'];
      }

      allow create: if isPanitia() && isValidEvent(incoming()) && incoming().status == 'pending';
      allow update: if (isPanitia() && existing().organizerId == request.auth.uid && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'date', 'location', 'posterUrl', 'capacity', 'rsvpDeadline']) &&
                        isValidEvent(incoming())) ||
                      (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
                      isRsvpCounterUpdate() ||
                      isRatingAggregateUpdate();
      allow delete: if isAdmin() || (isPanitia() && existing().organizerId == request.auth.uid);

      // RSVPs subcollection
      match /rsvps/{rsvpId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(eventId);
        allow update: if ((isAdmin() || isPanitia() || isOrganizerOf(eventId)) && isCheckInUpdate()) ||
                         isWaitlistPromotion();
        allow delete: if isOwner(existing().userId) || isAdmin() || isOrganizerOf(eventId);
      }

      // Ulasan pasca-event: satu dokumen per peserta, id dokumen = uid
      match /reviews/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId) &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().rating is int &&
                                 incoming().rating >= 1 && incoming().rating <= 5 &&
                                 (!('comment' in incoming()) || incoming().comment.size() <= 500);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(eventId);
        allow delete: if isOwner(existing().userId) || isAdmin() || isOrganizerOf(eventId);
      }
    }

    // Event yang disimpan (bookmark) — hanya pemiliknya yang boleh membaca/menulis
    match /users/{userId}/saved/{eventId} {
      allow read, write: if isOwner(userId);
    }

    // Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId);
      allow create: if isSignedIn(); // Allow any signed-in user to send notifications
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
    }
  }
}
